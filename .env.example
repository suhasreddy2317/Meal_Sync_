# Supabase application settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Meal cutoff times (24-hour HH:MM)
DEFAULT_BREAKFAST_CUTOFF_TIME=06:00
DEFAULT_LUNCH_CUTOFF_TIME=10:00
DEFAULT_DINNER_CUTOFF_TIME=17:00

# Initial administrator setup
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace_with_a_strong_password
INITIAL_ADMIN_NAME=MealSync Administrator

# Optional SMTP settings
GOOGLE_SMTP_USER=your_smtp_username
GOOGLE_SMTP_PASS=your_smtp_app_password
GOOGLE_SMTP_HOST=smtp.gmail.com
GOOGLE_SMTP_PORT=465
GOOGLE_SMTP_SECURE=true
GOOGLE_SMTP_FROM=MealSync <your_smtp_username>

# Required only by direct database utility scripts
SUPABASE_DB_HOST=db.your-project-ref.supabase.co
SUPABASE_DB_PASSWORD=your_supabase_database_password

# Required only by the OTP delivery test script
TEST_EMAIL=your_test_email@example.com
